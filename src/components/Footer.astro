---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';

const links = [
  { label: 'GitHub', href: site.repo },
  { label: 'crates.io', href: site.crates },
  { label: 'docs.rs', href: site.docs },
  { label: 'X', href: site.x },
  { label: 'fframes.studio', href: site.studio },
  { label: '赞助', href: site.sponsor },
];
---

<footer class="mt-24 overflow-hidden md:mt-36">
  <div class="wrap">
    <div class="flex flex-col gap-10 border-t border-line pt-10 md:flex-row md:justify-between">
      <div class="max-w-[40ch]">
        <p class="text-[15px] leading-relaxed text-ink-2">
          fframes 是一个开源项目，代码、示例和 skill 指南都放在同一个仓库里。欢迎提 issue 和 pull request。
        </p>
        <a
          href={site.license}
          target="_blank"
          rel="noreferrer noopener"
          class="link mt-4 inline-flex items-center gap-1.5 text-[15px]"
        >
          MIT 许可证
          <Icon name="ph:arrow-up-right" class="h-3.5 w-3.5" aria-hidden="true" />
        </a>
      </div>

      <ul class="grid grid-cols-2 gap-x-12 gap-y-2.5 sm:grid-cols-3">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noreferrer noopener"
                class="inline-flex items-center gap-1 rounded text-[15px] text-ink transition-colors duration-150 ease-out hover:text-accent-ink"
              >
                {link.label}
                <Icon name="ph:arrow-up-right" class="h-3 w-3 opacity-60" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer-mark pointer-events-none mt-14 select-none md:mt-20">
    <div class="echo" style="--from: 28px" aria-hidden="true"></div>
    <div class="echo" style="--from: 64px" aria-hidden="true"></div>
    <img
      src="/brand/fframes-wordmark.svg"
      alt="fframes"
      width="392"
      height="99"
      class="dark:hidden block w-full"
      loading="lazy"
      decoding="async"
    />
    <img
      src="/brand/fframes-wordmark-dark.svg"
      alt=""
      width="392"
      height="99"
      class="hidden w-full dark:block"
      loading="lazy"
      decoding="async"
    />
  </div>
</footer>

<style>
  .footer-mark {
    position: relative;
    margin-bottom: -6vw;
  }

  .footer-mark img {
    display: block;
    width: 100%;
    height: auto;
    mask-image: linear-gradient(to bottom, #000 4%, rgb(0 0 0 / 0.3) 62%, transparent 94%);
  }

  .echo {
    position: absolute;
    inset: 0;
    background-color: var(--accent);
    mask-image: var(--wordmark);
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
    opacity: 0.14;
  }

  .echo:last-of-type {
    opacity: 0.07;
  }

  /* The motion trail only exists once the mark has scrolled into frame. */
  @keyframes echo-out {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(var(--from), 0, 0);
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .echo {
        animation: echo-out linear both;
        animation-timeline: view();
        animation-range: entry 15% cover 42%;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .echo {
      animation: none;
    }
  }
</style>
