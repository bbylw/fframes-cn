---
/**
 * Section heading. Stacked, never split: the headline sits on top and the
 * lead paragraph below it, capped at a readable measure.
 */
interface Props {
  title: string;
  lead?: string;
  as?: 'h2' | 'h3';
  class?: string;
}

const { title, lead, as: Tag = 'h2', class: className = '' } = Astro.props;
---

<div class:list={['reveal', className]}>
  <Tag class="text-[clamp(1.75rem,3.6vw,2.75rem)] leading-[1.12] tracking-[-0.028em] text-balance">
    <slot name="title">{title}</slot>
  </Tag>
  {
    lead && (
      <p class="mt-4 max-w-[62ch] text-base leading-relaxed text-ink-2 md:text-[17px]">{lead}</p>
    )
  }
  <slot />
</div>
