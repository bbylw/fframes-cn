---
import { Icon } from 'astro-icon/components';
import { releaseFacts, releaseVideo, site } from '../../data/site';
---

<section id="top" class="pt-16 pb-4 md:pt-24">
  <div class="wrap">
    <h1
      class="rise-y max-w-[15ch] text-[clamp(2.4rem,7.2vw,5.25rem)] leading-[1.06] tracking-[-0.032em]"
      style="--t: 60ms"
    >
      <span class="block">真正<span class="sweep text-accent-ink">够快</span>的视频</span>
      <span class="block">氛围编程框架</span>
    </h1>

    <div class="rise mt-7 flex max-w-[54ch] gap-x-6 gap-y-3 md:mt-9" style="--t: 180ms">
      <span class="rule mt-2.5 hidden shrink-0 sm:block" aria-hidden="true"></span>
      <p class="text-[17px] leading-relaxed text-ink-2 md:text-[19px]">
        <span class="block">用 Rust 写每一帧，用 SVG 描述画面，</span>
        <span class="block">Skia 与 ffmpeg 在 GPU 上完成渲染。</span>
      </p>
    </div>

    <div class="rise mt-8 flex flex-wrap items-center gap-3 md:mt-10" style="--t: 300ms">
      <a
        href="#start"
        class="inline-flex h-12 items-center rounded-full bg-invert px-7 text-[16px] font-medium text-invert-fg transition-[background-color,transform] duration-150 ease-out hover:bg-invert-hover active:translate-y-[1px]"
      >
        安装 fframes
      </a>
      <a
        href={site.repo}
        target="_blank"
        rel="noreferrer noopener"
        class="inline-flex h-12 items-center gap-2 rounded-full border border-control-line px-6 text-[16px] font-medium text-ink transition-[background-color,transform] duration-150 ease-out hover:bg-ghost active:translate-y-[1px]"
      >
        GitHub 仓库
        <Icon name="ph:arrow-up-right" class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>

    <figure class="rise mt-12 md:mt-16" style="--t: 420ms">
      <a
        href={releaseVideo.href}
        target="_blank"
        rel="noreferrer noopener"
        class="group block overflow-hidden rounded-card border border-line bg-surface-2 shadow-[0_8px_16px_-4px_rgb(0_0_0/0.12),0_32px_64px_-36px_rgb(0_0_0/0.35)]"
      >
        <img
          src={releaseVideo.poster}
          alt="fframes 发布视频的一帧，128 秒的发布视频全部由 fframes 渲染"
          width={releaseVideo.width}
          height={releaseVideo.height}
          class="block aspect-video w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.012]"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </a>
      <figcaption class="mt-3.5 flex items-start gap-3 pl-3 text-[15px] leading-relaxed text-ink-2">
        <Icon
          name="ph:arrow-bend-down-left"
          class="mt-1 h-8 w-8 shrink-0 text-accent-ink"
          aria-hidden="true"
        />
        <span>
          {releaseVideo.lead}
          {releaseVideo.tail}
          <a
            href={releaseVideo.href}
            target="_blank"
            rel="noreferrer noopener"
            class="link font-medium text-ink"
          >
            {releaseVideo.name}
          </a>
        </span>
      </figcaption>
    </figure>

    <ul
      class="rise mt-12 grid grid-cols-2 border-y border-line md:mt-14 md:grid-cols-4"
      style="--t: 520ms"
    >
      {
        releaseFacts.map((fact) => (
          <li class="border-line odd:border-r md:border-r md:last:border-r-0">
            <a
              href={fact.href}
              target="_blank"
              rel="noreferrer noopener"
              class="group flex h-full flex-col gap-1 px-1 py-4 md:px-5"
            >
              <span class="font-mono text-[12.5px] tracking-[0.05em] text-ink-3">
                {fact.label}
              </span>
              <span class="text-[17px] font-medium text-ink transition-colors duration-150 ease-out group-hover:text-accent-ink">
                {fact.value}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
